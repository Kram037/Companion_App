{
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "name": "companion-app",
  "projectType": "application",
  "sourceRoot": ".",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite --host 127.0.0.1 --port 8000"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/companion-app"],
      "options": {
        "command": "npm run vite:build"
      }
    },
    "vite-serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run vite:dev"
      }
    },
    "vite-build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/companion-app"],
      "options": {
        "command": "npm run vite:build"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run typecheck && node tools/check-js.mjs && node tools/check-data-boundary.mjs && node tools/check-index-bootstrap.mjs && node tools/check-react-boundaries.mjs && node tools/check-legacy-symbols.mjs"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run test"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run e2e"
      }
    }
  }
}
